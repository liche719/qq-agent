#!/bin/bash
# wechat-deploy —— CI 专用的部署入口（服务端唯一出口）
#
# 由 /root/.ssh/authorized_keys 里的 command="/usr/local/bin/wechat-deploy" 强制调用：
# 客户端想跑什么都会变成 $SSH_ORIGINAL_COMMAND，这里只认下面几个子命令，别的全是用法提示。
#
# 为什么三个上传要 HMAC：
#   restrict + command= 只保证"拿不到 shell"。光有部署私钥的人仍然可以传一个自己造的镜像包，
#   再让 deploy 把它跑起来（host 网络 + root）= 等于拿到了 root。所以每次上传都要求
#   HMAC-SHA256(文件 sha256)，密钥只在 GitHub Secrets 与 /etc/wechat-deploy.secret（600）。
#   密钥不泄露，光有私钥就一个字都写不进来。
#
# 变更这个脚本 = 变更线上部署路径：改完先手动跑一遍 upload/deploy 再 push 触发 CI。
set -euo pipefail
umask 077

SECRET_FILE=/etc/wechat-deploy.secret
BASE=/var/lib/wechat-deploy
INCOMING=$BASE/incoming
# 分片落在整包旁边（save_stdin 本来就用 $INCOMING 做 mktemp 的目录，所以这个目录一定存在）
PARTS_DIR=$INCOMING
COMPOSE_DIR=/opt/qq-agent
COMPOSE_FILE=$COMPOSE_DIR/docker-compose.remote.yml
SETTINGS_FILE=$COMPOSE_DIR/docker/searxng/settings.yml
LOG=/var/log/wechat-deploy.log
DOCKER=/usr/bin/docker
OPENSSL=/usr/bin/openssl
ADMIN_USER=${WECHAT_DEPLOY_ADMIN_USER:-rootlcw}
# 2026-10-21：镜像改从 GitHub 的镜像仓库拉（只拉变化的层，比每次传 956MB tar 快得多）。
# token 只要 read:packages 一个权限，泄露的后果是"能拉私有镜像"，不能推。
# 仓库的真实名字是 liche719/qq-agent（老名字 wechat-qq-agent 只是 GitHub 上的重定向，
# 但 **ghcr 的镜像名不会跟着重定向**——写错就是 Package not found）。
GHCR_IMAGE=ghcr.io/liche719/qq-agent
GHCR_TOKEN_FILE=/etc/wechat-deploy/ghcr-token

log() { printf '%s %s\n' "$(date -Is)" "$*" >>"$LOG" 2>/dev/null || true; }
die() { log "REJECT: $* | orig=${SSH_ORIGINAL_COMMAND:-<none>}"; printf 'wechat-deploy: %s\n' "$*" >&2; exit 1; }

usage() {
  cat >&2 <<'EOF'
wechat-deploy: 只接受以下子命令（其它命令一律拒绝，不提供 shell）
  wechat-deploy upload-image <git-sha> <sha256> <hmac>
  wechat-deploy upload-image-part <git-sha> <序号> <sha256> <hmac>
  wechat-deploy join-image <git-sha> <分片数> <整包 sha256> <hmac>
  wechat-deploy upload-compose <sha256> <hmac>
  wechat-deploy upload-settings <sha256> <hmac>
  wechat-deploy deploy <git-sha>            (从本地 tar 装，旧路径)
  wechat-deploy pull-deploy <git-sha>       (从 ghcr.io 拉，新路径)
  wechat-deploy smoke-admin      (stdin: KEY=... [USER=...])
  wechat-deploy alert-notify     (stdin: KEY=... / MSG=...)
EOF
  exit 1
}

is_sha256() { [ "${#1}" = 64 ] && case "$1" in *[!0-9a-f]*) return 1;; *) return 0;; esac; }
is_git_sha() { [ "${#1}" = 40 ] && case "$1" in *[!0-9a-f]*) return 1;; *) return 0;; esac; }

# 密钥两端的换行差异（PowerShell 管道 / gh secret set 都可能带一个 \n）在这里统一吃掉，
# 否则会出现"本地算得出、CI 算不出"的诡异不匹配。
hmac_of() { printf '%s' "$1" | "$OPENSSL" dgst -sha256 -hmac "$(tr -d '\r\n' <"$SECRET_FILE")" | awk '{print $NF}'; }

check_mac() { # $1=sha256 $2=hmac $3=用途
  [ -r "$SECRET_FILE" ] || die "secret file $SECRET_FILE 不存在"
  is_sha256 "$1" || die "sha256 格式不对（$3）"
  [ "$(hmac_of "$1")" = "$2" ] || die "hmac 校验失败（$3）"
}

save_stdin() { # $1=目标路径 $2=期望 sha256
  local tmp got
  tmp=$(mktemp "$INCOMING/.upload.XXXXXX")
  cat >"$tmp"
  got=$(sha256sum "$tmp" | cut -d' ' -f1)
  if [ "$got" != "$2" ]; then rm -f "$tmp"; die "内容 sha256 不符（期望 $2，实际 $got）"; fi
  mv -f "$tmp" "$1"
}

cmd_upload_image() { # $1=git-sha $2=sha256 $3=hmac
  is_git_sha "$1" || die "git sha 格式不对"
  check_mac "$2" "$3" image
  save_stdin "$INCOMING/qq-agent-$1.tar.gz" "$2"
  log "upload-image ok sha=$1 bytes=$(stat -c%s "$INCOMING/qq-agent-$1.tar.gz")"
}

# 分片上传（2026-09-30 加）：**为什么需要它** —— GitHub runner（Azure 美国）到这台机器
# 的国际路由会"单条 TCP 塌缩"。实测同一份数据：单流 31 KB/s，8 路并行 182 KB/s（快 5.85 倍），
# 227 MB 的镜像因此从 44 秒劣化到 118 分钟。分片并行上传把这个瓶颈绕开。
# 安全性不变：每一片各自带 HMAC + sha256；合并后再校验**整包** sha256 才算通过。
cmd_upload_image_part() { # $1=git-sha $2=序号 $3=sha256 $4=hmac
  is_git_sha "$1" || die "git sha 格式不对"
  case "$2" in ''|*[!0-9]*) die "分片序号必须是非负整数";; esac
  [ "${#2}" -le 4 ] || die "分片序号过大"
  check_mac "$3" "$4" image-part
  save_stdin "$PARTS_DIR/wechat-agent-$1.part$2" "$3"
}

cmd_join_image() { # $1=git-sha $2=分片数 $3=整包 sha256 $4=hmac
  is_git_sha "$1" || die "git sha 格式不对"
  case "$2" in ''|*[!0-9]*) die "分片数必须是非负整数";; esac
  [ "$2" -ge 1 ] && [ "$2" -le 512 ] || die "分片数不在 1..512"
  check_mac "$3" "$4" image-join
  local target="$INCOMING/qq-agent-$1.tar.gz" got i part
  rm -f "$target"
  i=0
  while [ "$i" -lt "$2" ]; do
    part="$PARTS_DIR/wechat-agent-$1.part$i"
    [ -f "$part" ] || { remove_parts "$1" "$2"; die "缺少分片 $i"; }
    cat "$part" >>"$target" || { remove_parts "$1" "$2"; die "合并分片 $i 失败"; }
    i=$((i + 1))
  done
  got=$(sha256sum "$target" | cut -d' ' -f1)
  if [ "$got" != "$3" ]; then
    rm -f "$target"
    remove_parts "$1" "$2"
    die "合并后 sha256 不符（期望 $3，实际 $got）"
  fi
  remove_parts "$1" "$2"
  log "join-image ok sha=$1 parts=$2 bytes=$(stat -c%s "$target")"
}

# **不要写成 `rm -f ...part*`**：本脚本第 201 行有 `set -f`（禁用 glob，防止原始命令里的
# `*` 被展开），通配符在这里不会展开，`rm` 会拿到一个字面量路径、什么都不删——
# 227 MB 的分片就这么留在了磁盘上（2026-09-30 自测抓到的）。所以只能逐个删。
remove_parts() { # $1=git-sha $2=分片数
  local i=0
  while [ "$i" -lt "$2" ]; do
    rm -f "$PARTS_DIR/wechat-agent-$1.part$i"
    i=$((i + 1))
  done
}

cmd_upload_compose() { # $1=sha256 $2=hmac
  check_mac "$1" "$2" compose
  local tmp=$COMPOSE_DIR/.wechat-deploy.compose.tmp
  save_stdin "$tmp" "$1"
  # 校验必须在目标目录里跑：compose 的挂载路径是相对文件所在目录解析的
  if ! (cd "$COMPOSE_DIR" && "$DOCKER" compose -f "$tmp" config -q) 2>/tmp/wechat-deploy.err; then
    rm -f "$tmp"
    die "compose 校验不通过：$(head -c 300 /tmp/wechat-deploy.err)"
  fi
  rm -f /tmp/wechat-deploy.err
  [ -f "$COMPOSE_FILE" ] && cp -f "$COMPOSE_FILE" "$COMPOSE_FILE.bak-wechat-deploy"
  mv -f "$tmp" "$COMPOSE_FILE"
  log "upload-compose ok sha256=$1"
}

cmd_upload_settings() { # $1=sha256 $2=hmac
  check_mac "$1" "$2" settings
  local tmp=$BASE/.settings.tmp
  save_stdin "$tmp" "$1"
  grep -q '^use_default_settings:' "$tmp" || { rm -f "$tmp"; die "settings.yml 缺少 use_default_settings"; }
  # 「密钥不进仓库」这条约束由这里兜底：secret_key 不允许带值
  if grep -Eq '^[[:space:]]*secret_key:[[:space:]]*[^[:space:]]' "$tmp"; then
    rm -f "$tmp"; die "settings.yml 里不允许出现 secret_key 的值"
  fi
  mkdir -p "$(dirname "$SETTINGS_FILE")"
  [ -f "$SETTINGS_FILE" ] && cp -f "$SETTINGS_FILE" "$SETTINGS_FILE.bak-wechat-deploy"
  mv -f "$tmp" "$SETTINGS_FILE"
  log "upload-settings ok sha256=$1"
}

cmd_deploy() { # $1=git-sha
  is_git_sha "$1" || die "git sha 格式不对"
  local tar=$INCOMING/qq-agent-$1.tar.gz
  [ -s "$tar" ] || die "镜像包还没上传：$tar"
  "$DOCKER" load -i "$tar" >/dev/null
  cd "$COMPOSE_DIR"
  # 2026-10-22 项目改名：旧容器名 wechat-agent-java 占着 443，先移除再起新容器（卷不动）
  "$DOCKER" rm -f wechat-agent-java >/dev/null 2>&1 || true
  AGENT_IMAGE=qq-agent:"$1" "$DOCKER" compose -f "$COMPOSE_FILE" up -d --no-build agent
  # searxng 的 settings.yml 是挂载进去的，不热加载
  "$DOCKER" restart qq-agent-searxng >/dev/null
  "$DOCKER" image prune -f >/dev/null
  # 只保留「当前容器镜像 + 次新镜像」的全部 tag（按 image id 数，不能按 tag 行数——同内容重建会让新 tag 被误删）
  local cur prev
  cur=$("$DOCKER" inspect qq-agent -f '{{.Image}}' 2>/dev/null || true)
  prev=$("$DOCKER" images --no-trunc --format '{{.ID}}|{{.CreatedAt}}' --filter 'reference=qq-agent:*' \
    | awk -F'|' -v cur="$cur" '$1!=cur' | sort -r -t'|' -k2 | head -1 | cut -d'|' -f1 || true)
  "$DOCKER" images --no-trunc --format '{{.ID}}|{{.Repository}}:{{.Tag}}' --filter 'reference=qq-agent:*' \
    | awk -F'|' -v cur="$cur" -v prev="$prev" '$1!=cur && $1!=prev {print $2}' \
    | xargs -r "$DOCKER" rmi -f >/dev/null 2>&1 || true
  rm -f "$tar"
  # 顺手清掉上传目录里超过一天的残留（被取消的流水线会留下半截包）
  find "$INCOMING" -maxdepth 1 -type f -mmin +1440 -delete 2>/dev/null || true
  "$DOCKER" compose -f "$COMPOSE_FILE" ps agent
  "$DOCKER" images --format '{{.Repository}}:{{.Tag}}' --filter 'reference=qq-agent:*'
  log "deploy ok sha=$1"
}

# 从 ghcr.io 拉镜像并部署（2026-10-21）。
#
# 和 cmd_deploy 的唯一区别是**镜像从哪来**：那边是 CI 传上来的 tar，这边是 registry。
# 好处是 docker 只拉缺的层——基础镜像 + apt 那 600MB 不用每次重传。
cmd_pull_deploy() { # $1=git-sha
  is_git_sha "$1" || die "git sha 格式不对"
  local image="$GHCR_IMAGE:$1"
  [ -s "$GHCR_TOKEN_FILE" ] || die "缺 ghcr token：$GHCR_TOKEN_FILE（read:packages 权限即可）"
  tr -d '\r\n' <"$GHCR_TOKEN_FILE" | "$DOCKER" login ghcr.io -u liche719 --password-stdin >/dev/null \
    || die "ghcr 登录失败（token 过期/权限不对）"
  "$DOCKER" pull "$image" >/dev/null || die "拉镜像失败：$image"
  cd "$COMPOSE_DIR"
  AGENT_IMAGE="$image" "$DOCKER" compose -f "$COMPOSE_FILE" up -d --no-build agent
  # searxng 的 settings.yml 是挂载进去的，不热加载
  "$DOCKER" restart qq-agent-searxng >/dev/null
  "$DOCKER" image prune -f >/dev/null
  # 只保留「当前 + 次新」两代（按 image id 数，不按 tag 行数）
  local cur prev
  cur=$("$DOCKER" inspect qq-agent -f '{{.Image}}' 2>/dev/null || true)
  prev=$("$DOCKER" images --no-trunc --format '{{.ID}}|{{.CreatedAt}}' --filter "reference=$GHCR_IMAGE:*" \
    | awk -F'|' -v cur="$cur" '$1!=cur' | sort -r -t'|' -k2 | head -1 | cut -d'|' -f1 || true)
  "$DOCKER" images --no-trunc --format '{{.ID}}|{{.Repository}}:{{.Tag}}' --filter "reference=$GHCR_IMAGE:*" \
    | awk -F'|' -v cur="$cur" -v prev="$prev" '$1!=cur && $1!=prev {print $2}' \
    | xargs -r "$DOCKER" rmi -f >/dev/null 2>&1 || true
  # 2026-10-21：同一个 image 会被打上多个 sha 标签（代码没变时 Docker 复用同一层，
  # 多个 tag 指向同一个 image id）。image 只占一份空间，但标签会一直堆。
  #
  # ⚠️ **必须先排除"当前容器正在用的那个标签"**。踩过的坑：本想按 CreatedAt 留最近两个，
  # 但 CI 复用构建缓存时几个镜像的 CreatedAt 完全一样，排序不稳定，结果把**刚拉下来的
  # 那个**当成旧的删了标签——容器还在用（image 没删），但 `docker images` 里看不到它。
  local cur_tag
  cur_tag=$("$DOCKER" inspect qq-agent -f '{{.Config.Image}}' 2>/dev/null || true)
  "$DOCKER" images --format '{{.Repository}}:{{.Tag}}|{{.CreatedAt}}' --filter "reference=$GHCR_IMAGE:*" \
    | grep -v -F "${cur_tag}|" \
    | sort -r -t'|' -k2 | tail -n +2 | cut -d'|' -f1 \
    | xargs -r "$DOCKER" rmi >/dev/null 2>&1 || true
  "$DOCKER" compose -f "$COMPOSE_FILE" ps agent
  "$DOCKER" images --format '{{.Repository}}:{{.Tag}}' --filter "reference=$GHCR_IMAGE:*"
  log "pull-deploy ok sha=$1"
}

read_stdin_vars() { # 从 stdin 读 KEY= / MSG= / USER= 这类行，不打印
  while IFS= read -r line; do
    case "$line" in
      KEY=*) ADMIN_KEY=${line#KEY=} ;;
      MSG=*) ALERT_MSG=${line#MSG=} ;;
      USER=*) ADMIN_USER=${line#USER=} ;;
    esac
  done
}

cmd_smoke_admin() {
  local ADMIN_KEY=""
  read_stdin_vars
  [ -n "$ADMIN_KEY" ] || die "没有从 stdin 读到 KEY="
  local withkey login
  withkey=$(curl -sk -o /dev/null -w '%{http_code}' -H "X-Agent-Admin-Key: $ADMIN_KEY" https://127.0.0.1/api/admin/overview)
  login=$(curl -sk -o /dev/null -w '%{http_code}' -X POST -H 'Content-Type: application/json' \
    -H "X-Agent-Admin-Key: $ADMIN_KEY" -d "{\"username\":\"$ADMIN_USER\"}" https://127.0.0.1/api/admin/session)
  printf 'withkey=%s login=%s\n' "$withkey" "$login"
}

cmd_alert_notify() {
  local ADMIN_KEY="" ALERT_MSG=""
  read_stdin_vars
  [ -n "$ADMIN_KEY" ] || die "没有从 stdin 读到 KEY="
  curl -sk -o /dev/null --max-time 20 -X POST -H "X-Agent-Admin-Key: $ADMIN_KEY" \
    -H 'Content-Type: application/json' \
    -d "$(printf '{"message":%s}' "$(printf '%s' "${ALERT_MSG:-部署后自检失败}" | python3 -c 'import json,sys;print(json.dumps(sys.stdin.read()))')")" \
    https://127.0.0.1/api/admin/actions/alerts/notify || true
  log "alert-notify sent"
}

mkdir -p "$INCOMING"
chmod 700 "$BASE" "$INCOMING"

set -f   # 原始命令里带 * 之类的字符时不做 glob 展开
# 装了 command= 之后，客户端的命令在 SSH_ORIGINAL_COMMAND 里；
# 直接在服务器上手工执行（排障/兜底）时没有这个变量，就用脚本自己的参数。
if [ -n "${SSH_ORIGINAL_COMMAND:-}" ]; then set -- $SSH_ORIGINAL_COMMAND; fi
[ "$#" -ge 1 ] || usage
[ "$1" = "wechat-deploy" ] && shift
[ "$#" -ge 1 ] || usage
sub=$1; shift

case "$sub" in
  upload-image)    [ "$#" = 3 ] || usage; cmd_upload_image "$1" "$2" "$3" ;;
  upload-image-part) [ "$#" = 4 ] || usage; cmd_upload_image_part "$1" "$2" "$3" "$4" ;;
  join-image)      [ "$#" = 4 ] || usage; cmd_join_image "$1" "$2" "$3" "$4" ;;
  upload-compose)  [ "$#" = 2 ] || usage; cmd_upload_compose "$1" "$2" ;;
  upload-settings) [ "$#" = 2 ] || usage; cmd_upload_settings "$1" "$2" ;;
  deploy)          [ "$#" = 1 ] || usage; cmd_deploy "$1" ;;
  pull-deploy) [ "$#" = 1 ] || usage; cmd_pull_deploy "$1" ;;
  smoke-admin)     [ "$#" = 0 ] || usage; cmd_smoke_admin ;;
  alert-notify)    [ "$#" = 0 ] || usage; cmd_alert_notify ;;
  *) usage ;;
esac
