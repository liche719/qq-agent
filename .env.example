# 复制为 .env 后自行填写；不要把真实密钥提交到 Git。

# ---- LLM（必填）----
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_SECONDS=60
LLM_CONNECT_TIMEOUT_SECONDS=5

# ---- QQ 官方机器人 ----
QQ_ENABLED=false
QQ_APP_ID=
QQ_CLIENT_SECRET=
QQ_SANDBOX=true
QQ_GROUP_ENABLED=false
QQ_API_CONNECT_TIMEOUT_SECONDS=5
QQ_API_READ_TIMEOUT_SECONDS=15
QQ_WEBSOCKET_CONNECT_TIMEOUT_SECONDS=10
QQ_PASSIVE_WINDOW_MS=300000
QQ_TYPING_KEEPALIVE_MS=50000
QQ_EPHEMERAL_CACHE_TTL_MS=1800000
QQ_STREAM_STATE_TTL_MS=600000
QQ_MAX_CONVERSATION_CACHE_ENTRIES=2048
QQ_MAX_MESSAGE_CACHE_ENTRIES=4096
QQ_MAX_MESSAGE_CHARS=4000
QQ_USER_AGENT=qqbot-nodejs/1.0.4
QQ_RECONNECT_BACKOFF_MS=2000,5000,10000,30000
QQ_RECONNECT_DELAY_MS=2000
QQ_TOKEN_DEFAULT_EXPIRE_SECONDS=7200
QQ_TOKEN_REFRESH_LEAD_MS=60000
QQ_DEFAULT_HEARTBEAT_MS=45000
QQ_INPUT_NOTIFY_SECONDS=60
QQ_MARKDOWN_MAX_CHARS=4000

# 默认仅启动 QQ；仅在需要微信兼容通道或本地模拟器时显式设置 clawbot 或 simulator。
WECHAT_CHANNEL_MODE=disabled

# ---- 本机基础设施 ----
SERVER_PORT=8080
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=wechat_agent
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_POOL_MAX_SIZE=8
MYSQL_POOL_MIN_IDLE=2
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TIMEOUT=3s
QUARTZ_THREAD_COUNT=4

# ---- Agent 运行策略 ----
AGENT_WORKERS=8
AGENT_QUEUE_CAPACITY=200
AGENT_GLOBAL_QUEUE_CAPACITY=400
AGENT_USER_QUEUE_IDLE_MINUTES=30
AGENT_MESSAGE_BATCH_WINDOW_MILLIS=1500
AGENT_MESSAGE_BATCH_MAX_WINDOW_MILLIS=4000
AGENT_MESSAGE_BATCH_CONTINUATION_WINDOW_MILLIS=900
# 留空可关闭“媒体后补充文字”自动合并；按部署语言自行配置正则。
AGENT_MESSAGE_BATCH_CONTINUATION_PATTERN=
AGENT_TOOL_RETRY_ATTEMPTS=1
AGENT_TOOL_MAX_RESULT_CHARS=8000
AGENT_MAX_TOOL_ROUNDS=8
AGENT_STREAM_TIMEOUT_SECONDS=120
AGENT_IMAGE_MAX_REDIRECTS=3
AGENT_IMAGE_CONNECT_TIMEOUT_SECONDS=8
AGENT_IMAGE_READ_TIMEOUT_SECONDS=20
AGENT_STREAM_CHUNK_CHARS=24
AGENT_STREAM_CHUNK_DELAY_MS=120
AGENT_TOOL_PROGRESS_ENABLED=false
AGENT_MESSAGE_IDEMPOTENCY_TTL_HOURS=24
AGENT_CURRENT_TIME_PATTERN=(?s).*?(?:现在(?:是)?几点|当前(?:是)?几点|(?:现在|当前)(?:的)?时间|今天(?:是)?(?:几号|星期几|周几|日期)).*
# 可选：覆盖新用户默认人设；不填则使用内置通用人设。
AGENT_DEFAULT_PERSONA=
AGENT_MAX_PERSONA_CHARS=2000

# ---- 网络与文件安全上限 ----
APP_TIME_ZONE=Asia/Shanghai
SCHEDULER_TASK_POOL_SIZE=2
SCHEDULER_THREAD_NAME_PREFIX=scheduled-task-
AGENT_MESSAGE_BATCH_THREAD_NAME_PREFIX=message-batch-
MEMORY_EXTRACTION_THREAD_POOL_SIZE=2
MEMORY_EXTRACTION_THREAD_NAME_PREFIX=memory-extract-
SEARXNG_BASE_URL=http://localhost:8888
SEARXNG_TIMEOUT_SECONDS=15
SEARXNG_CONNECT_TIMEOUT_SECONDS=5
SEARXNG_MAX_RESULTS=5
WEB_MAX_RESPONSE_BYTES=2097152
WEB_MAX_TEXT_CHARS=12000
WEB_MAX_REDIRECTS=3
WEB_MAX_LINKS=20
WEB_CONNECT_TIMEOUT_SECONDS=8
WEB_READ_TIMEOUT_SECONDS=20
WEB_USER_AGENT=Mozilla/5.0 (compatible; WechatAgent/1.0)
DOCUMENT_MAX_FILE_BYTES=20971520
DOCUMENT_MAX_TEXT_CHARS=60000
DOCUMENT_MAX_PDF_PAGES=10
DOCUMENT_MAX_REDIRECTS=3
DOCUMENT_CONNECT_TIMEOUT_SECONDS=8
DOCUMENT_READ_TIMEOUT_SECONDS=30
DOCUMENT_USER_AGENT=Mozilla/5.0 (compatible; WechatAgent/1.0)
SEARXNG_LANGUAGE=zh-CN
SEARXNG_MAX_RESULTS=10
MEDIA_STORAGE_ROOT=stored-media
MEDIA_STORAGE_MAX_FILE_BYTES=20971520
MEDIA_INSPECTION_TOKEN_MINUTES=5
MEDIA_STORAGE_MAX_REDIRECTS=3
MEDIA_STORAGE_CONNECT_TIMEOUT_SECONDS=8
MEDIA_STORAGE_READ_TIMEOUT_SECONDS=30
MEDIA_STORAGE_MAX_LIST_RESULTS=20
MEDIA_STORAGE_INSPECTION_MAX_TEXT_CHARS=4000
MEDIA_STORAGE_USER_AGENT=Mozilla/5.0 (compatible; WechatAgent/1.0)
MEDIA_CONTEXT_PENDING_TTL_MINUTES=30
MEDIA_CONTEXT_MAX_PENDING_PER_CONVERSATION=8
MEDIA_CONTEXT_EXCERPT_MAX_CHARS=4000

# ---- 管理页面/API ----
# 本机默认仅监听 127.0.0.1；若以 production profile 对外部署，必须设置强随机密钥。
ADMIN_API_KEY=
ADMIN_REQUIRE_KEY=false
ADMIN_ALLOW_LOOPBACK_WITHOUT_KEY=true

# ---- 隐私 ----
CONVERSATION_TRACE_ENABLED=false
CONVERSATION_TRACE_MAX_CHARS=8000

# ---- 主动关怀 ----
CARE_MIN_FOCUS_PRIORITY=4
CARE_WEEKLY_DAY=SUNDAY
CARE_RETRY_DELAY_MINUTES=60

# ---- 记忆 ----
MEMORY_CONTEXT_ROUNDS=10
MEMORY_CONTEXT_TTL_HOURS=720
MEMORY_CORE_MAX_LOAD=16
MEMORY_CORE_MAX_CHARS=2200
MEMORY_WORK_MAX_LOAD=15
MEMORY_WORK_MAX_CHARS=1500
MEMORY_WORK_ARCHIVE_THRESHOLD=20
MEMORY_WORK_ARCHIVE_BATCH=10
MEMORY_ARCHIVE_SWEEP_INTERVAL_MS=600000
MEMORY_ARCHIVE_SWEEP_INITIAL_DELAY_MS=300000
MEMORY_EXTRACTION_WINDOW_SECONDS=3
MEMORY_EXTRACTION_RETRY_ATTEMPTS=2
MEMORY_EXTRACTION_RETRY_DELAY_SECONDS=15
MEMORY_DEDUP_THRESHOLD=0.8
MEMORY_USAGE_TOUCH_INTERVAL_MINUTES=15
MEMORY_EXTRACTION_MAX_CANDIDATES=32
MEMORY_EXTRACTION_MAX_CONTENT_CHARS=4000
MEMORY_EXTRACTION_MAX_KEYWORDS=8
MEMORY_EXTRACTION_DEFAULT_CONFIDENCE=85
MEMORY_EXTRACTION_RECENT_TURNS=20
MEMORY_MIN_CONFIDENCE=60
MEMORY_DEFAULT_WORK_PRIORITY=3
MEMORY_DEFAULT_CORE_IMPORTANCE=5
MEMORY_DEFAULT_WORK_IMPORTANCE=3
MEMORY_CORE_MAX_CONTENT_CHARS_LIMIT=4000
MEMORY_WORK_MAX_CONTENT_CHARS_LIMIT=2000
MEMORY_LINKED_MEDIA_MAX_PER_MEMORY=3
MEMORY_LINKED_MEDIA_SUMMARY_MAX_CHARS=80
MEMORY_HISTORICAL_ITEM_MAX_CHARS=1200
MEMORY_ARCHIVE_SUMMARY_TARGET_CHARS=100
MEMORY_ARCHIVE_SUMMARY_MAX_CHARS=1000
MEMORY_ARCHIVE_SUMMARY_CONFIDENCE=70
# 逗号分隔；留空由 application.yml 的默认值接管
MEMORY_HISTORY_MARKERS=
MEMORY_CONVERSATION_RETRIEVAL_NOISE=
MEMORY_NEGATION_MARKERS=
MEMORY_HISTORICAL_RETRIEVAL_LIMIT=8
MEMORY_HISTORICAL_MIN_SCORE=3
MEMORY_CONVERSATION_EXTRACTION_LIMIT=80
MEMORY_CONVERSATION_RETRIEVAL_LIMIT=2000
MEMORY_CONVERSATION_SEARCH_PER_TERM=16
MEMORY_CONVERSATION_MAX_RETRIEVAL_TERMS=8
MEMORY_CONVERSATION_FORGET_SCAN_BATCH=250
MEMORY_CONVERSATION_RETENTION_DAYS=3650
MEMORY_CONVERSATION_MAX_CONTENT_CHARS=12000
MEMORY_LIFECYCLE_SCAN_INTERVAL_MS=3600000
MEMORY_LIFECYCLE_INITIAL_DELAY_MS=60000

# ---- 提醒与主动关怀 ----
REMINDER_DEFAULT_PREWARM_MINUTES=10
REMINDER_MISFIRE_GRACE_SECONDS=60
REMINDER_RECOVERY_SCAN_INTERVAL_MS=300000
REMINDER_RECOVERY_INITIAL_DELAY_MS=120000
REMINDER_MAX_RECENT_STATUS_RESULTS=12
CARE_SCAN_INTERVAL_MS=60000
CARE_INITIAL_DELAY_MS=30000
CARE_DELIVERY_TIME=20:30
CARE_FOCUS_MAX_CHARS=100

# ---- 本机备份 ----
BACKUP_DIR=backup
BACKUP_CONVERSATION_LIMIT=10000
BACKUP_CHANGE_LOG_LIMIT=5000
BACKUP_CRON=0 0 3 * * ?
BACKUP_RETENTION_DAYS=30
