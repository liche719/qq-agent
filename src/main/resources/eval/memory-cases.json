    {
      "id": "hard-many-rooms",
      "type": "extract",
      "conversation": [
        "六门课：高数 8B101，线代 8B102，概率 8B103，电路 8B201，信号 8B202，物理 8B203"
      ]
    },
    {
      "id": "hard-exact-room",
      "type": "recall",
      "fromCase": "hard-many-rooms",
      "query": "8B203 是哪门课",
      "expectTopContains": "物理"
    },
    {
      "id": "mind-change",
      "type": "extract",
      "conversation": [
        "我考研考 408 计算机统考",
        "我改考自命题了，不考 408 了"
      ],
      "expectFacts": [
        {
          "objectAny": [
            "自命题"
          ]
        }
      ],
      "forbidFacts": [
        "408"
      ]
    }
  ]
}