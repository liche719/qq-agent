          "text": "以后叫我阿文就行"
        },
        {
          "role": "assistant",
          "text": "好，阿文。"
        }
      ],
      "question": "我手机号多少来着？",
      "expectContains": "13800138000"
    },
    {
      "id": "cont-nickname",
      "type": "continuity",
      "history": [
        {
          "role": "user",
          "text": "以后叫我阿文就行"
        },
        {
          "role": "assistant",
          "text": "好，阿文。"
        },
        {
          "role": "user",
          "text": "周二晚上的课教室改成 8B304 了"
        },
        {
          "role": "assistant",
          "text": "记下了。"
        }
      ],
      "question": "你该怎么称呼我？",
      "expectContains": "阿文"
    },
    {
      "id": "cont-intern",
      "type": "continuity",
      "history": [
        {
          "role": "user",
          "text": "寒假打算去深圳找实习，先待两个月"
        },
        {
          "role": "assistant",
          "text": "深圳，两个月。"
        },
        {
          "role": "user",
          "text": "投简历大概 11 月 5 号开始"
        },
        {
          "role": "assistant",
          "text": "好，11 月 5 号。"
        }
      ],
      "question": "我寒假实习打算去哪？",
      "expectContains": "深圳"
